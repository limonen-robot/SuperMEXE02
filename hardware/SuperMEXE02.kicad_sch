	(text "SuperMEXE02 / COMPLETE HARDWARE ON ONE SHEET"
		(at 25.4 25.4 0)
		(effects
			(font
				(size 4 4)
			)
			(justify left)
		)
		(uuid "89dee5c9-3b8f-474f-b912-a48cb055217a")
	)
	(text "Two NUCLEO-G431KB boards / four AZD-K drives / five QC19004 relays / two MDR-100-24 supplies"
		(at 25.4 38.1 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left)
		)
		(uuid "d0705172-0316-4d89-97c2-fff445447c6d")
	)
	(text "A/B: PS1, 24V_AB and 0V_AB.   C/D: PS2, 24V_CD and 0V_CD.   Both 24V negative rails remain separate from MCU GND."
		(at 25.4 48.26 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left)
		)
		(uuid "96ecbe94-a3d7-4531-bfea-2170e5eda346")
	)
	(text "CONNECTION GUIDE"
		(at 50.8 533.4 0)
		(effects
			(font
				(size 2.8 2.8)
			)
			(justify left)
		)
		(uuid "1d61811b-d812-49dc-a1fc-080522b51efd")
	)
	(text "All components and all recorded wiring are on this page. There are no child sheets."
		(at 50.8 548.64 0)
		(effects
			(font
				(size 1.7 1.7)
			)
			(justify left)
		)
		(uuid "848449b3-e2b5-4e24-9c31-01051eb29274")
	)
	(text "Identical labels are electrical connections; a long drawn wire is not required between equal labels."
		(at 50.8 561.34 0)
		(effects
			(font
				(size 1.7 1.7)
			)
			(justify left)
		)
		(uuid "20111d71-df40-4500-a4c6-2fca8e27e885")
	)
	(text "A_CW/A_CCW/A_HOME link the motor MCU to axis A; B/C/D use the same naming rule."
		(at 50.8 574.04 0)
		(effects
			(font
				(size 1.7 1.7)
			)
			(justify left)
		)
		(uuid "8ef36387-b51b-48ed-bdf9-236c196132bf")
	)
	(text "GND and +3V3 are the shared MCU supply references. 0V_AB and 0V_CD are independent 24V returns."
		(at 50.8 586.74 0)
		(effects
			(font
				(size 1.7 1.7)
			)
			(justify left)
		)
		(uuid "7d6bfbe0-3921-4f04-b825-933c57c6596e")
	)
	(text "CN4-5 is IN-COM[4-7]. CN4-22 is a different GND terminal and is not used as the ZHOME return."
		(at 50.8 599.44 0)
		(effects
			(font
				(size 1.7 1.7)
			)
			(justify left)
		)
		(uuid "30f60629-53d4-4936-b559-752b1420de86")
	)
	(text "Pin assignments and component values are unchanged from revision 0.5."
		(at 50.8 612.14 0)
		(effects
			(font
				(size 1.7 1.7)
			)
			(justify left)
		)
		(uuid "24b6ee99-9dd3-42c5-aeef-e4f03013f247")
	)
	(text "Native KiCad and SVG are scalable; zoom in to inspect the full pin labels."
		(at 50.8 624.84 0)
		(effects
			(font
				(size 1.7 1.7)
			)
			(justify left)
		)
		(uuid "7939e20b-211a-47e7-9562-d3dcc21cfd73")
	)
